        <mxCell id="f8" value="&lt;b&gt;f8 晶圆热变形与液浸蒸发冷缩残差 (0.71 nm)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#334155&quot;&gt;两层 3σ · 单层 0.50 nm (WT+蒸发 0.44 + WH 瞬态 0.24) · p_T: 剂量/场序&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0E7490;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fontColor=#0F172A;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
