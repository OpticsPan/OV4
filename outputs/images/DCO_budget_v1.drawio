        <mxCell id="motion-v16" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D1 · 闭环内的计量要求&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;ENC 是台体定位反馈。&lt;br/&gt;框架相对物镜位置影响像面。&lt;br/&gt;两者均在同步运动项内落实。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="541" width="351" height="165" as="geometry" />
        </mxCell>
        <mxCell id="motion-v17" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;曝光窗计量 / 频域核验&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;按实际曝光权重对 PSD 积分求 MA。&lt;br/&gt;平移读数 X/Y 用 1∶4 缩小换算。&lt;br/&gt;曝光窗底噪、换头跳变、长期标尺漂移分别测量。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="541" width="363" height="165" as="geometry" />
        </mxCell>
        <mxCell id="motion-v18" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;编码器 ENC 与计量框架 MF&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;WS-ENC X/Y ≤ 0.12/0.12 nm；Rz ≤ 1.5 nrad。&lt;br/&gt;RS-ENC X/Y ≤ 0.32/0.36 nm（掩模侧）；Rz ≤ 2.5 nrad。&lt;br/&gt;WS 换头 ≤ 0.15 nm，网格板 7 天稳定性 ≤ 0.18 nm。&lt;br/&gt;MF–物镜动态 X/Y 各 ≤ 0.15 nm，满速扫描、曝光窗 MA。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="541" width="543" height="165" as="geometry" />
