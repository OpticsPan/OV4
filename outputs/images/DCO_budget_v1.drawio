        <mxCell id="process-v26" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D6 · 掩模夹持&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;0.212 → 0.300 nm / 轴" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="885" width="351" height="128" as="geometry" />
        </mxCell>
        <mxCell id="process-v27" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;独立卸夹与滑移残差&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;RSS(0.15, 0.15) = 0.212 nm。&lt;br/&gt;掩模平移形变 4∶1 折至晶圆平面。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="885" width="363" height="128" as="geometry" />
        </mxCell>
        <mxCell id="process-v28" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;RT 掩模台&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;掩模侧重夹 ≤ 0.60 nm；150 m/s² 正反扫微滑移 ≤ 0.60 nm。晶圆侧各 ≤ 0.15 nm。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="885" width="543" height="128" as="geometry" />
        </mxCell>
        <mxCell id="process-e29" parent="1" edge="1" source="process-v26" target="process-v27" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="process-e30" parent="1" edge="1" source="process-v27" target="process-v28" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="process-v31" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D7 · 晶圆夹持&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;0.292 → 0.412 nm / 轴" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="1038" width="351" height="128" as="geometry" />
        </mxCell>
        <mxCell id="process-v32" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;重复吸片与扫描微滑移&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;RSS(0.25, 0.15) = 0.292 nm。&lt;br/&gt;去除可校正线性项，保留随机残差。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="1038" width="363" height="128" as="geometry" />
        </mxCell>
        <mxCell id="process-v33" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;WT 晶圆台&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;同一参考片重复吸附后的不可校变形 ≤ 0.25 nm。&lt;br/&gt;35–40 m/s² 折返正反扫微滑移 ≤ 0.15 nm。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="1038" width="543" height="128" as="geometry" />
        </mxCell>
        <mxCell id="process-e34" parent="1" edge="1" source="process-v31" target="process-v32" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="process-e35" parent="1" edge="1" source="process-v32" target="process-v33" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="process-v36" parent="1" vertex="1" value="来源　《九大核心子系统说明书 v2》§4–6；《整机及子系统报告 v2》§5–12。上述为设计预算 / 验收目标，实际双层贡献须由重装、正反扫、热工况及对准重复性记录验证。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=15;spacingRight=15;spacingTop=0;spacingBottom=0;strokeColor=#E2C69E;fillColor=#FFF5E7;fontColor=#94511B;fontFamily=Noto Sans CJK SC;fontSize=15;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="1192" width="1353" height="74" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="field" name="D8–D9 · 场内补偿">
    <mxGraphModel grid="0" guides="1" tooltips="1" connect="1" page="1" pageScale="1" pageWidth="1418" pageHeight="1098" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="field-v1" parent="1" vertex="1" value="D8–D9 · 场内补偿" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;fontColor=#143344;fontFamily=Noto Sans CJK SC;fontSize=29;fontStyle=1;arcSize=4;">
          <mxGeometry x="32" y="22" width="1353" height="55" as="geometry" />
        </mxCell>
        <mxCell id="field-v2" parent="1" vertex="1" value="按执行器归属分配 K 系数残差。x、y 用 cm，场角 |x|=1.30、|y|=1.65。下列 ΔK 为允许绝对残差，角点套刻的单位为 nm。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;fontColor=#446170;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="80" width="1353" height="42" as="geometry" />
        </mxCell>
        <mxCell id="field-v3" parent="1" vertex="1" value="预算 / 两层目标贡献" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;strokeColor=#143344;fillColor=#143344;fontColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=1;arcSize=4;">
          <mxGeometry x="32" y="136" width="351" height="40" as="geometry" />
        </mxCell>
        <mxCell id="field-v4" parent="1" vertex="1" value="传递 / 可复算示例" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;strokeColor=#143344;fillColor=#143344;fontColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=1;arcSize=4;">
          <mxGeometry x="431" y="136" width="363" height="40" as="geometry" />
        </mxCell>
        <mxCell id="field-v5" parent="1" vertex="1" value="子系统验收 / 全系数限值" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;strokeColor=#143344;fillColor=#143344;fontColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=1;arcSize=4;">
          <mxGeometry x="842" y="136" width="543" height="40" as="geometry" />
        </mxCell>
        <mxCell id="field-v6" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D8 · 物镜 iHOPC / X&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;6 项；单层场角 RSS 0.317 nm。&lt;br/&gt;报告采用双层 ×1.20 → 0.380 nm。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="191" width="351" height="189" as="geometry" />
        </mxCell>
        <mxCell id="field-v7" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;K3 线性放大率&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;δₓ = |ΔK₃| × 1.30&lt;br/&gt;0.100 nm/cm × 1.30 cm = 0.130 nm。&lt;br/&gt;Gₘ = |x|ᵖ|y|ᑫ；各项场角贡献按轴 RSS。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="191" width="363" height="189" as="geometry" />
        </mxCell>
        <mxCell id="field-v8" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;物镜 X 向 6 项&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;一次（nm/cm）：K3 0.100。&lt;br/&gt;二次（nm/cm²）：K7 0.080，K9 0.060。&lt;br/&gt;三次（nm/cm³）：K13 0.060，K15 0.045，K17 0.035。&lt;br/&gt;K3 步长 ≤ 0.010 nm/cm，单向 / 滞回 ≤ 0.035 / 0.025 nm/cm。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="191" width="543" height="189" as="geometry" />
        </mxCell>
        <mxCell id="field-e9" parent="1" edge="1" source="field-v6" target="field-v7" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="field-e10" parent="1" edge="1" source="field-v7" target="field-v8" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="field-v11" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D8 · 物镜 iHOPC / Y&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;2 项；单层场角 RSS 0.184 nm。&lt;br/&gt;双层 ×1.20 → 0.221 nm。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="405" width="351" height="146" as="geometry" />
        </mxCell>
        <mxCell id="field-v12" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;K12、K18&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;RSS(0.080 × 1.30²,&lt;br/&gt;0.045 × 1.30² × 1.65) ≈ 0.184 nm。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="405" width="363" height="146" as="geometry" />
        </mxCell>
        <mxCell id="field-v13" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;物镜 Y 向 2 项&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;K12 ≤ 0.080 nm/cm²；K18 ≤ 0.045 nm/cm³。&lt;br/&gt;机内 SET/GET 与片上 51×19 密点验收；&lt;br/&gt;K20 冷机静畸变另属 MMO。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="405" width="543" height="146" as="geometry" />
        </mxCell>
        <mxCell id="field-e14" parent="1" edge="1" source="field-v11" target="field-v12" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="field-e15" parent="1" edge="1" source="field-v12" target="field-v13" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="field-v16" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D9 · 晶圆台 iHOPC / X&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;4 项；单层场角 RSS 0.228 nm。&lt;br/&gt;双层 ×1.20 → 0.274 nm。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="576" width="351" height="194" as="geometry" />
        </mxCell>
        <mxCell id="field-v17" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;K5 扫描斜行&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;δₓ = |ΔK₅| × 1.65&lt;br/&gt;0.070 nm/cm × 1.65 cm = 0.116 nm。&lt;br/&gt;采用角点口径，场 RMS 是另一个统计量。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="576" width="363" height="194" as="geometry" />
        </mxCell>
        <mxCell id="field-v18" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;WS X 向 4 项&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;K1 ≤ 0.120 nm；K5 ≤ 0.070 nm/cm；&lt;br/&gt;K11 ≤ 0.040 nm/cm²；K19 ≤ 0.025 nm/cm³。&lt;br/&gt;成像验收测高密度场内标记，按规定基函数拟合残差。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="576" width="543" height="194" as="geometry" />
        </mxCell>
        <mxCell id="field-e19" parent="1" edge="1" source="field-v16" target="field-v17" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="field-e20" parent="1" edge="1" source="field-v17" target="field-v18" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="field-v21" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D9 · 晶圆台 iHOPC / Y&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;7 项；单层场角 RSS 0.293 nm。&lt;br/&gt;双层 ×1.20 → 0.352 nm。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="795" width="351" height="179" as="geometry" />
        </mxCell>
        <mxCell id="field-v22" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;K4 扫描倍率&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;δᵧ = |ΔK₄| × 1.65 ≈ 0.116 nm。&lt;br/&gt;K4 离线伺服 ≤ 0.039 nm/cm，&lt;br/&gt;全链总残差 ≤ 0.070 nm/cm。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="795" width="363" height="179" as="geometry" />
        </mxCell>
        <mxCell id="field-v23" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;WS Y 向 7 项&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;K2 ≤ 0.120 nm；K4 / K6 ≤ 0.070 / 0.080 nm/cm；&lt;br/&gt;K8 / K10 ≤ 0.040 / 0.050 nm/cm²；&lt;br/&gt;K14 / K16 ≤ 0.025 / 0.030 nm/cm³。&lt;br/&gt;按 5.5 mm 狭缝曝光窗核对遥测和最终片上残差。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="795" width="543" height="179" as="geometry" />
        </mxCell>
        <mxCell id="field-e24" parent="1" edge="1" source="field-v21" target="field-v22" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="field-e25" parent="1" edge="1" source="field-v22" target="field-v23" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="field-v26" parent="1" vertex="1" value="来源　《九大核心子系统说明书 v2》§7.3–7.4、§9.3–9.4。×1.20 是仓库的层间残差预算系数，须在实际补偿条件下验证。系统 RSS 使用系数限值派生的角点值。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=15;spacingRight=15;spacingTop=0;spacingBottom=0;strokeColor=#E2C69E;fillColor=#FFF5E7;fontColor=#94511B;fontFamily=Noto Sans CJK SC;fontSize=15;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="1000" width="1353" height="74" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="aberr" name="D10–D11 · 波像差与余项">
    <mxGraphModel grid="0" guides="1" tooltips="1" connect="1" page="1" pageScale="1" pageWidth="1418" pageHeight="1097" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="aberr-v1" parent="1" vertex="1" value="D10–D11 · 波像差与余项" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;fontColor=#143344;fontFamily=Noto Sans CJK SC;fontSize=29;fontStyle=1;arcSize=4;">
          <mxGeometry x="32" y="22" width="1353" height="55" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v2" parent="1" vertex="1" value="跨照明套刻使用差分灵敏度。D11 是账内的未建模扰动与量测本底分配，独立于闭环结果到 2.00 nm 的剩余空间。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;fontColor=#446170;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="80" width="1353" height="42" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v3" parent="1" vertex="1" value="预算 / 传回 DCO" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;strokeColor=#143344;fillColor=#143344;fontColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=1;arcSize=4;">
          <mxGeometry x="32" y="136" width="351" height="40" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v4" parent="1" vertex="1" value="传递 / 控制量定义" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;strokeColor=#143344;fillColor=#143344;fontColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=1;arcSize=4;">
          <mxGeometry x="431" y="136" width="363" height="40" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v5" parent="1" vertex="1" value="子系统验收 / 指标" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;strokeColor=#143344;fillColor=#143344;fontColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=1;arcSize=4;">
          <mxGeometry x="842" y="136" width="543" height="40" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v6" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D10 · 物镜 Odd Zernike&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;稳健包络：X/Y 各 0.370 nm。&lt;br/&gt;跨照明差分已含两层 → 系数 1.00。&lt;br/&gt;Abbe 仿真单轴 0.328 nm，作交叉核对。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="191" width="351" height="193" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v7" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;Z7 / Z8 彗差示例&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;eⱼ = |ΔSⱼ| × |ΔZⱼ|。&lt;br/&gt;0.950 nm/nm Fringe × 0.18 nm Fringe&lt;br/&gt;= 0.171 nm / 轴。&lt;br/&gt;按每一轴、每个模式 RSS。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="191" width="363" height="193" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v8" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;控制量与量测&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;每个 Z7/Z8 ≤ 0.18 nm Fringe，相当于 0.0636 nm RMS。&lt;br/&gt;单轴合成取 15 个对应方向的贡献，覆盖 30 个奇模式。&lt;br/&gt;PARIS/ILC 测量重复性 ≤ 0.12 nm RMS；多次测量、机内监测与片上跨照明配对，用于核验闭环残差。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="191" width="543" height="193" as="geometry" />
        </mxCell>
        <mxCell id="aberr-e9" parent="1" edge="1" source="aberr-v6" target="aberr-v7" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aberr-e10" parent="1" edge="1" source="aberr-v7" target="aberr-v8" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v11" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D10 · 30 项模式限值&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;右表按 X/Y 成对列出。&lt;br/&gt;单位均为 nm Fringe，限值为绝对值。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="409" width="351" height="225" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v12" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;示例：Z10 / Z11 三叶项&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;0.910 × 0.16 = 0.146 nm / 轴。&lt;br/&gt;所有模式使用各自的跨照明包络。&lt;br/&gt;单轴 15 项见 §8.2 的对应灵敏度列。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="409" width="363" height="225" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v13" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;各模式对的容许幅值&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Z7/8 0.18　·　Z10/11 0.16　·　Z14/15 0.18&lt;br/&gt;Z19/20 0.20　·　Z23/24 0.24　·　Z26/27 0.16&lt;br/&gt;Z30/31 0.22　·　Z34/35 0.30　·　Z39/40 0.22&lt;br/&gt;Z43/44 0.30　·　Z47/48 0.35　·　Z50/51 0.24&lt;br/&gt;Z54/55 0.25　·　Z58/59 0.35　·　Z62/63 0.40" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="409" width="543" height="225" as="geometry" />
        </mxCell>
        <mxCell id="aberr-e14" parent="1" edge="1" source="aberr-v11" target="aberr-v12" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aberr-e15" parent="1" edge="1" source="aberr-v12" target="aberr-v13" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v16" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D11 · 未建模扰动与量测本底&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;单层 X/Y 各 0.250 nm。&lt;br/&gt;双层 ×√2 → 各 0.354 nm。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="659" width="351" height="144" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v17" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;合并分配&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;仓库为两类来源给出一个合并上限。&lt;br/&gt;单独贡献需要量具与印片的重复数据辨识。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="659" width="363" height="144" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v18" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;建议验证（待实测）&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;固定参考片重复读数估计量测重复性，再做重复曝光。&lt;br/&gt;检查去除已建模项后残差及其协方差，对照 0.250 nm 单层等效预算。保留设备、层对与量具条件。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="659" width="543" height="144" as="geometry" />
        </mxCell>
        <mxCell id="aberr-e19" parent="1" edge="1" source="aberr-v16" target="aberr-v17" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aberr-e20" parent="1" edge="1" source="aberr-v17" target="aberr-v18" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v21" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;系统偏置 · |Mean|&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;每一轴预留 0.300 nm。&lt;br/&gt;对两层随机合成值作线性加法。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="828" width="351" height="145" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v22" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;最终验收量&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;按轴从成对印片残差求均值和离散度。&lt;br/&gt;对片、场、点的同一抽样规则求 |Mean| + 3σ。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="828" width="363" height="145" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v23" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;同机同台闭环&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;两轴分别对照 ≤ 2.00 nm。&lt;br/&gt;用实测协方差检查 D1–D11 的 RSS 假设；重新估计共享基线、热变化及层间相关对合成的影响。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="828" width="543" height="145" as="geometry" />
        </mxCell>
        <mxCell id="aberr-e24" parent="1" edge="1" source="aberr-v21" target="aberr-v22" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aberr-e25" parent="1" edge="1" source="aberr-v22" target="aberr-v23" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aberr-v26" parent="1" vertex="1" value="来源　《九大核心子系统说明书 v2》§6、§8.1–8.2；《整机及子系统报告 v2》§0、§15。报告给出的控制幅值为分配规格，传递后才成为晶圆面套刻预算。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=15;spacingRight=15;spacingTop=0;spacingBottom=0;strokeColor=#E2C69E;fillColor=#FFF5E7;fontColor=#94511B;fontFamily=Noto Sans CJK SC;fontSize=15;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="999" width="1353" height="74" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
