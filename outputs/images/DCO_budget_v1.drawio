        <mxCell id="motion-v21" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;验收边界 · 焦面与模糊&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;D1 的横向预算取 X、Y、Rz。&lt;br/&gt;Z、Rx、Ry 同步另验 FU。&lt;br/&gt;MSD 表征窗内运动模糊。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
