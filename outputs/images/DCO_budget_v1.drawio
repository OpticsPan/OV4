        <mxCell id="note1" parent="1" vertex="1" value="最紧预算在 Y 轴&#10;2.000 − 1.869 = 0.131 nm（6.55%）&#10;此数为系统余量；D11 已计入随机项。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#FFF5E4;strokeColor=#DBBD80;strokeWidth=1.4;fontColor=#6D4B26;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=10;">
