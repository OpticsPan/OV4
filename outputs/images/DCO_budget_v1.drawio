        <mxCell id="motion-v22" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;其余自由度的折算&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;RS → 晶圆侧：Z 用 n水/16，&lt;br/&gt;Rx、Ry 用 n水/4。&lt;br/&gt;Sync Z ≤ 5.0 nm；Rx/Ry ≤ 0.25/0.12 μrad。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
