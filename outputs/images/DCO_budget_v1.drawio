        </mxCell>
        <mxCell id="motion-v2" parent="1" vertex="1" value="同机同台、曝光窗 MA、晶圆平面。左侧是预算，中列是误差传递，右侧是可单测的硬件指标。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;fontColor=#446170;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="80" width="1353" height="42" as="geometry" />
        </mxCell>
        <mxCell id="motion-v3" parent="1" vertex="1" value="预算 / 单层等效量" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;strokeColor=#143344;fillColor=#143344;fontColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=1;arcSize=4;">
          <mxGeometry x="32" y="136" width="351" height="40" as="geometry" />
        </mxCell>
        <mxCell id="motion-v4" parent="1" vertex="1" value="传递 / 折算" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;strokeColor=#143344;fillColor=#143344;fontColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=1;arcSize=4;">
          <mxGeometry x="431" y="136" width="363" height="40" as="geometry" />
        </mxCell>
        <mxCell id="motion-v5" parent="1" vertex="1" value="子系统验收 / 条件" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;strokeColor=#143344;fillColor=#143344;fontColor=#FFFFFF;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=1;arcSize=4;">
          <mxGeometry x="842" y="136" width="543" height="40" as="geometry" />
        </mxCell>
        <mxCell id="motion-v6" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D1 · 非扫描方向 X&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;平移 ≤ 0.400 nm&lt;br/&gt;偏航造成边缘位移 0.04125 nm&lt;br/&gt;单层 RSS 0.4021 nm → 两层 0.5687 nm" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="191" width="351" height="150" as="geometry" />
        </mxCell>
        <mxCell id="motion-v7" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;晶圆面相对位移&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;eₓ = MA(xWS − xRS/4)&lt;br/&gt;RSS(0.32, 0.96/4) = 0.400 nm&lt;br/&gt;偏航：2.75 mm × 15 nrad = 0.04125 nm" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="191" width="363" height="150" as="geometry" />
        </mxCell>
        <mxCell id="motion-v8" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;WS、RS 动态往返定位&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;WS-X ≤ 0.32 nm；RS-X ≤ 0.96 nm（掩模侧）。&lt;br/&gt;5.5 mm 狭缝、晶圆扫描 0.70 m/s，MA 窗约 7.86 ms。&lt;br/&gt;两台独立测量后，以同步遥测核验实际差分与协方差。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="842" y="191" width="543" height="150" as="geometry" />
        </mxCell>
        <mxCell id="motion-e9" parent="1" edge="1" source="motion-v6" target="motion-v7" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="motion-e10" parent="1" edge="1" source="motion-v7" target="motion-v8" style="endArrow=blockThin;endFill=1;strokeWidth=1.6;strokeColor=#64838B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="motion-v11" parent="1" vertex="1" value="&lt;font color=&quot;#00766B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;D1 · 扫描方向 Y&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;平移 ≤ 0.450 nm&lt;br/&gt;偏航造成边缘位移 0.195 nm&lt;br/&gt;单层 RSS 0.4904 nm → 两层 0.6936 nm" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#E9F5F2;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="32" y="366" width="351" height="150" as="geometry" />
        </mxCell>
        <mxCell id="motion-v12" parent="1" vertex="1" value="&lt;font color=&quot;#225C7B&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;平移差与角位移&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;eᵧ = MA(yWS − yRS/4)&lt;br/&gt;RSS(0.36, 1.08/4) = 0.450 nm&lt;br/&gt;偏航：13 mm × 15 nrad = 0.195 nm" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#F0F6FA;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
          <mxGeometry x="431" y="366" width="363" height="150" as="geometry" />
        </mxCell>
        <mxCell id="motion-v13" parent="1" vertex="1" value="&lt;font color=&quot;#143344&quot; style=&quot;font-size:19px&quot;&gt;&lt;b&gt;WS、RS 平移与偏航&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;WS-Y ≤ 0.36 nm；RS-Y ≤ 1.08 nm（掩模侧）。&lt;br/&gt;WS-Rz ≤ 12 nrad；RS-Rz ≤ 9 nrad；RSS = 15 nrad。&lt;br/&gt;RS-Rz 为 1∶1 角度传递。正反扫与 150 m/s² 掩模折返单验。" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;strokeColor=#B8CDD1;fillColor=#FBFCFC;fontColor=#193443;fontFamily=Noto Sans CJK SC;fontSize=16;fontStyle=0;arcSize=4;">
