        <mxCell id="motion-v1" parent="1" vertex="1" value="D1 · 运动与计量" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;fontColor=#143344;fontFamily=Noto Sans CJK SC;fontSize=29;fontStyle=1;arcSize=4;">
