        </mxCell>
        <mxCell id="foot" parent="1" vertex="1" value="读图方向   从左向右分配规格，从右向左复算。先将物理量投影到晶圆像面，再作层间差分；各独立项按轴 RSS，最后加 |μ|。" style="rounded=0;arcSize=12;whiteSpace=wrap;html=0;fillColor=#DEECEB;strokeColor=none;strokeWidth=1.4;fontColor=#164F50;fontFamily=Noto Sans CJK SC;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="36" y="1028" width="1533" height="55" />
        </mxCell>
        <mxCell id="source" parent="1" vertex="1" value="依据   Freriks 等（2006），Fig. 3；OV4 九大说明书 v2 §0–9；整机报告 v2 §0.3、§7–12；工作簿 v2 表 01、04、05。&#10;版本核对   X 轴：旧表 8 mm 为 1.834 nm；按 5.5 mm 重算为 1.833 nm；九大说明书摘要列 1.832 nm。Y 轴均为 1.869 nm。" style="rounded=0;arcSize=12;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.4;fontColor=#536B73;fontFamily=Noto Sans CJK SC;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="36" y="1090" width="1530" height="72" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="motion" name="D1 · 运动与计量">
    <mxGraphModel grid="0" guides="1" tooltips="1" connect="1" page="1" pageScale="1" pageWidth="1418" pageHeight="1009" math="0" shadow="0" background="#FFFFFF">
      <root>
